<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PassThePigs.App.ViewModels"
             x:Class="PassThePigs.App.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="28,20" Spacing="9">

            <Label Text="APPEARANCE" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource Gray500}" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Label Grid.Column="0" Text="Theme" VerticalOptions="Center" />
                <Border Grid.Column="1" Stroke="{StaticResource Secondary}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Padding="6,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Stage}, Dark={StaticResource StageDark}}">
                    <Picker ItemsSource="{Binding Themes}"
                            SelectedItem="{Binding SelectedTheme}"
                            Title="Theme" />
                </Border>
            </Grid>

            <Label Text="GAME" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource Gray500}" Margin="0,12,0,0" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Label Grid.Column="0" Text="Target score" VerticalOptions="Center" />
                <Border Grid.Column="1" Stroke="{StaticResource Secondary}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Padding="6,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Stage}, Dark={StaticResource StageDark}}">
                    <Picker ItemsSource="{Binding TargetScores}"
                            SelectedItem="{Binding SelectedTargetScore}"
                            Title="Target score" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,3,0,0">
                <Label Grid.Column="0" Text="Must hit the target exactly"
                       VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ExactWin}" />
            </Grid>
            <Label Text="An overshooting turn is forfeited."
                   FontSize="12" TextColor="{StaticResource Gray500}" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,3,0,0">
                <Label Grid.Column="0" Text="First turn" VerticalOptions="Center" />
                <Border Grid.Column="1" Stroke="{StaticResource Secondary}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Padding="6,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Stage}, Dark={StaticResource StageDark}}">
                    <Picker ItemsSource="{Binding FirstTurnOptions}"
                            SelectedItem="{Binding SelectedFirstTurn}"
                            Title="First turn" />
                </Border>
            </Grid>

            <Label Text="OPPONENT" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource Gray500}" Margin="0,12,0,0" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Slider Grid.Column="0" Minimum="0" Maximum="1000"
                        Value="{Binding AiRollDelay}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding AiDelayValue}"
                       VerticalOptions="Center" HorizontalTextAlignment="End"
                       MinimumWidthRequest="54"
                       FontSize="12" TextColor="{StaticResource Gray500}" />
            </Grid>
            <Label Text="Pause between the opponent's rolls. 0 also hides its dice."
                   FontSize="12" TextColor="{StaticResource Gray500}" />

            <Button Text="Done" Command="{Binding DoneCommand}"
                    Margin="0,16,0,0" HeightRequest="50"
                    FontSize="17" FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
