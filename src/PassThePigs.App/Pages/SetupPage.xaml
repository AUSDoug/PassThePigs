<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PassThePigs.App.ViewModels"
             x:Class="PassThePigs.App.Pages.SetupPage"
             x:DataType="vm:SetupViewModel"
             Title="Pass the Pigs">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18" VerticalOptions="Center">

            <Label Text="🐷" FontSize="72" HorizontalOptions="Center" />
            <Label Text="Pass the Pigs"
                   FontSize="34" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center" Margin="0,0,0,16" />

            <Label Text="OPPONENT" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource Gray500}" />
            <Border Stroke="{StaticResource Secondary}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 10" Padding="6,0"
                    IsVisible="{Binding ShowOpponentPicker}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Stage}, Dark={StaticResource StageDark}}">
                <Picker ItemsSource="{Binding Opponents}"
                        SelectedItem="{Binding SelectedOpponent}"
                        Title="Choose an opponent" />
            </Border>

            <Grid ColumnDefinitions="Auto,*">
                <Switch Grid.Column="0" IsToggled="{Binding RandomOpponent}" />
                <Label Grid.Column="1" VerticalOptions="Center" Margin="12,0,0,0"
                       Text="Random — a mystery opponent, drawn each game" />
            </Grid>

            <Button Text="Play"
                    Command="{Binding PlayCommand}"
                    Margin="0,24,0,0"
                    HeightRequest="56" FontSize="18" FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>

        <!-- Settings / Statistics -->
        <VerticalStackLayout HorizontalOptions="End" VerticalOptions="Start" Margin="0,4,4,0" Spacing="0">
            <Label Text="&#x2699;" FontSize="26" Padding="10"
                   TextColor="{StaticResource Gray500}"
                   HorizontalOptions="Center" SemanticProperties.Description="Settings">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Text="📊" FontSize="22" Padding="10"
                   HorizontalOptions="Center" SemanticProperties.Description="Statistics">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenStatsCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
