<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PassThePigs.App.ViewModels"
             x:Class="PassThePigs.App.Pages.SetupPage"
             x:DataType="vm:SetupViewModel"
             Title="Pass the Pigs">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18" VerticalOptions="Center">

            <Label Text="🐷" FontSize="72" HorizontalOptions="Center" />
            <Label Text="Pass the Pigs"
                   FontSize="34" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center" Margin="0,0,0,16" />

            <Label Text="OPPONENT" FontSize="12" FontAttributes="Bold"
                   TextColor="{StaticResource Gray500}" />
            <Border Stroke="{StaticResource Secondary}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 10" Padding="6,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Stage}, Dark={StaticResource StageDark}}">
                <Picker ItemsSource="{Binding Opponents}"
                        SelectedItem="{Binding SelectedOpponent}"
                        Title="Choose an opponent" />
            </Border>

            <Button Text="Play"
                    Command="{Binding PlayCommand}"
                    Margin="0,24,0,0"
                    HeightRequest="56" FontSize="18" FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>

        <!-- Settings -->
        <Label Text="&#x2699;" FontSize="26" Padding="10"
               TextColor="{StaticResource Gray500}"
               HorizontalOptions="End" VerticalOptions="Start"
               Margin="0,4,8,0" SemanticProperties.Description="Settings">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
</ContentPage>
